[node name="TitleLabel" type="Label" parent="."]
layout_mode = 0
offset_top = 30.0
offset_right = 480.0
offset_bottom = 99.0
theme_override_colors/font_outline_color = Color(0.08, 0.08, 0.1, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
