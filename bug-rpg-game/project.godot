; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bug_Rpg_Game"
run/main_scene="res://scenes/stage_tutorial.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

BugRegistry="*res://scripts/bug_registry.gd"
PlayerStats="*res://scripts/player_stats.gd"
GameUI="*res://scenes/game_ui.tscn"
BattleManager="*res://scenes/battle_manager.tscn"
Inventory="*res://scripts/inventory.gd"
ViewSwitcher="*res://scenes/view_switcher.tscn"
WorldState="*res://scripts/world_state.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=3
window/size/borderless=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

